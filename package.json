    "build": "pnpm -r build",
    "dev": "pnpm --filter cascade-search-website dev",
    "gen": "node training/gen.ts",
    "size": "node eval/size.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.72",
    "fast-check": "^4.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "webgpu": "^0.6.1"
  }
}
