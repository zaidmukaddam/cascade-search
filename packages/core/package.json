{
  "name": "cascade-search",
  "version": "0.2.0",
  "description": "A 27K-parameter in-browser query parser that knows when it doesn't know.",
  "keywords": [
    "search",
    "query-parser",
    "filter",
    "webgpu",
    "wgsl",
    "calibration",
    "cascade"
  ],
  "license": "MIT",
  "author": "Zaid Mukaddam",
  "homepage": "https://github.com/zaidmukaddam/cascade-search#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaidmukaddam/cascade-search.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/zaidmukaddam/cascade-search/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  }
}
