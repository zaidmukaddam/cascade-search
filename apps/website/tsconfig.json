{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "@webgpu/types"],
    "paths": {
      "@/*": ["./src/*"],
